  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "bench": "node bench.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint src/ build.mjs bench.mjs test/",
    "format": "prettier --write eslint.config.js bench.mjs package.json .prettierrc.json",
    "format:check": "prettier --check eslint.config.js bench.mjs package.json .prettierrc.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
