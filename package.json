{
  "name": "zelvior-runtime",
  "version": "0.3.9",
  "description": "Dependency-free, adaptive browser runtime for lazy loading, scheduling, and self-tuning performance based on live device/browser conditions.",
  "license": "MIT",
  "author": "Zelvior",
  "homepage": "https://github.com/zelvior/zelvior-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zelvior/zelvior-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/zelvior/zelvior-runtime/issues"
  },
  "keywords": [
    "performance",
    "browser",
    "runtime",
    "adaptive",
    "lazy-load",
    "scheduler",
    "requestIdleCallback",
    "intersection-observer",
    "web-performance"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/zelvior.cjs.js",
  "module": "./dist/zelvior.esm.js",
  "browser": "./dist/zelvior.js",
  "unpkg": "./dist/zelvior.min.js",
  "jsdelivr": "./dist/zelvior.min.js",
  "types": "./dist/zelvior.d.ts",
  "exports": {
    ".": {
      "types": "./dist/zelvior.d.ts",
      "browser": "./dist/zelvior.js",
      "import": "./dist/zelvior.esm.js",
      "require": "./dist/zelvior.cjs.js",
      "default": "./dist/zelvior.esm.js"
    },
    "./min": {
      "types": "./dist/zelvior.d.ts",
      "browser": "./dist/zelvior.min.js",
      "import": "./dist/zelvior.esm.min.js",
      "require": "./dist/zelvior.cjs.min.js",
      "default": "./dist/zelvior.esm.min.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "PERFORMANCE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
