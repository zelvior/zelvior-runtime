{
  "name": "zelvior-runtime",
  "version": "0.6.0",
  "description": "Dependency-free, adaptive browser runtime for lazy loading, scheduling, and self-tuning performance based on live device/browser conditions.",
  "license": "MIT",
  "author": "Zelvior",
  "homepage": "https://github.com/zelvior/zelvior-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zelvior/zelvior-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/zelvior/zelvior-runtime/issues"
  },
  "keywords": [
    "performance",
    "browser",
    "runtime",
    "adaptive",
    "lazy-load",
    "scheduler",
    "requestIdleCallback",
    "intersection-observer",
    "web-performance"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/zelvior.cjs",
  "module": "./dist/zelvior.esm.js",
  "browser": "./dist/zelvior.js",
  "unpkg": "./dist/zelvior.min.js",
  "jsdelivr": "./dist/zelvior.min.js",
  "types": "./dist/zelvior.d.ts",
  "exports": {
    ".": {
      "types": "./dist/zelvior.d.ts",
      "browser": "./dist/zelvior.js",
      "import": "./dist/zelvior.esm.js",
      "require": "./dist/zelvior.cjs",
      "default": "./dist/zelvior.esm.js"
    },
    "./min": {
      "types": "./dist/zelvior.d.ts",
      "browser": "./dist/zelvior.min.js",
      "import": "./dist/zelvior.esm.min.js",
      "require": "./dist/zelvior.min.cjs",
      "default": "./dist/zelvior.esm.min.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.esm.js",
      "require": "./dist/events.cjs",
      "default": "./dist/events.esm.js"
    },
    "./events/min": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.esm.min.js",
      "require": "./dist/events.min.cjs",
      "default": "./dist/events.esm.min.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.esm.js",
      "require": "./dist/dom.cjs",
      "default": "./dist/dom.esm.js"
    },
    "./dom/min": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.esm.min.js",
      "require": "./dist/dom.min.cjs",
      "default": "./dist/dom.esm.min.js"
    },
    "./scroll": {
      "types": "./dist/scroll.d.ts",
      "import": "./dist/scroll.esm.js",
      "require": "./dist/scroll.cjs",
      "default": "./dist/scroll.esm.js"
    },
    "./scroll/min": {
      "types": "./dist/scroll.d.ts",
      "import": "./dist/scroll.esm.min.js",
      "require": "./dist/scroll.min.cjs",
      "default": "./dist/scroll.esm.min.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.esm.js",
      "require": "./dist/virtual.cjs",
      "default": "./dist/virtual.esm.js"
    },
    "./virtual/min": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.esm.min.js",
      "require": "./dist/virtual.min.cjs",
      "default": "./dist/virtual.esm.min.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "landing-page",
    "assets",
    "README.md",
    "ARCHITECTURE.md",
    "PERFORMANCE.md",
    "ENGINEERING_REPORT.md",
    "CHANGELOG.md",
    "BUNDLE_SIZES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0"
  }
}
